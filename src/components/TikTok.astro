---
interface Props {
  id: string;
  caption?: string;
}
const { id, caption = 'TikTok video' } = Astro.props;
---
<figure class="my-6">
  <div class="tiktok-wrap">
    <div class="tiktok-embed">
      <iframe
        src={`https://www.tiktok.com/embed/v2/${id}`}
        title={caption}
        loading="lazy"
        allow="encrypted-media; picture-in-picture"
        allowfullscreen
        scrolling="no"
      ></iframe>
    </div>
  </div>
  {caption && <figcaption class="mt-2 text-center text-sm opacity-70">{caption}</figcaption>}
</figure>
