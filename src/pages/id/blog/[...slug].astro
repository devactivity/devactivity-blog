---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import YouTube from '../../../components/YouTube.astro';
import TikTok from '../../../components/TikTok.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { adSlots } from '../../../site';
import { postUrl, slugOf, ui } from '../../../i18n';
import { getCollection, render } from 'astro:content';

const lang = 'id' as const;
const t = ui[lang];

export async function getStaticPaths() {
  const all = await getCollection('blog', ({ data }) => !data.draft);
  const posts = all.filter((p) => p.data.lang === 'id');
  return posts.map((post) => {
    const slug = slugOf(post.id);
    const hasEn = all.some((p) => p.data.lang === 'en' && slugOf(p.id) === slug);
    return {
      params: { slug },
      props: { post, altPath: hasEn ? postUrl('en', slug) : '/blog/' },
    };
  });
}

const { post, altPath } = Astro.props;
const { Content } = await render(post);
const slug = slugOf(post.id);
const date = post.data.pubDate.toISOString().slice(0, 10);
const updated = post.data.updatedDate?.toISOString() ?? post.data.pubDate.toISOString();
const site = Astro.site ?? new URL('https://devactivity-blog.pages.dev');
const url = new URL(postUrl(lang, slug), site).toString();
const ogImage = post.data.youtubeId
  ? `https://i.ytimg.com/vi/${post.data.youtubeId}/hqdefault.jpg`
  : '/favicon.svg';

const author = {
  '@type': 'Person',
  name: 'devactivity',
  url: 'https://github.com/devactivity',
  sameAs: [
    'https://www.youtube.com/@devactivity',
    'https://www.tiktok.com/@devreactivity',
    'https://github.com/devactivity',
    'https://twitter.com/fndevactivity',
    'https://www.instagram.com/devactivity/',
  ],
};

const videos = [
  ...(post.data.youtubeId
    ? [{
        '@type': 'VideoObject',
        name: post.data.title,
        description: post.data.description,
        thumbnailUrl: `https://i.ytimg.com/vi/${post.data.youtubeId}/hqdefault.jpg`,
        uploadDate: post.data.pubDate.toISOString(),
        embedUrl: `https://www.youtube.com/embed/${post.data.youtubeId}`,
        author,
      }]
    : []),
  ...(post.data.tiktokId
    ? [{
        '@type': 'VideoObject',
        name: post.data.title,
        description: post.data.description,
        uploadDate: post.data.pubDate.toISOString(),
        embedUrl: `https://www.tiktok.com/embed/v2/${post.data.tiktokId}`,
        author,
      }]
    : []),
];

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(ogImage, site).toString(),
  datePublished: post.data.pubDate.toISOString(),
  dateModified: updated,
  inLanguage: t.inLanguage,
  author,
  publisher: {
    '@type': 'Person',
    name: 'devactivity',
    url: 'https://github.com/devactivity',
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  keywords: (post.data.tags ?? []).join(', '),
  ...(videos.length ? { hasPart: videos, video: videos[0] } : {}),
};
---

<BaseLayout
  title={`${post.data.title} - DevActivity`}
  description={post.data.description}
  lang={lang}
  altPath={altPath}
  canonicalPath={postUrl(lang, slug)}
  ogType="article"
  ogImage={ogImage}
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={updated}
  extraJsonLd={articleJsonLd}
>
  <article class="min-w-0">
    <div class="stamp-frame min-w-0">
      <div class="stamp-inner min-w-0 px-4 py-6 sm:px-6 sm:py-8 md:px-10 dark:bg-[#17181c]">
        <p class="font-black text-ai dark:text-sky text-sm tracking-[0.25em] break-words">{post.data.category ?? 'POST'}</p>
        <h1 class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl leading-tight mt-1 break-words">{post.data.title}</h1>
        <p class="mt-3 opacity-80 max-w-2xl break-words">{post.data.description}</p>
        <div class="mt-5 flex flex-wrap items-center gap-2 sm:gap-3 text-xs font-bold border-t-2 border-current pt-3">
          <span class="break-words">{post.data.category ?? 'POST'} NO.{post.data.no ?? '00'}</span>
          <time datetime={post.data.pubDate.toISOString()}>{date}</time>
          <span class="flex flex-wrap gap-1.5">
            {(post.data.tags ?? []).map((tag) => (
              <span class="border border-current/30 rounded-full px-2 py-0.5 break-words">#{tag}</span>
            ))}
          </span>
        </div>
      </div>
    </div>

    {(post.data.youtubeId || post.data.tiktokId) && (
      post.data.youtubeId && post.data.tiktokId ? (
        <div class="mt-8 grid min-w-0 gap-6 md:grid-cols-2">
          <YouTube id={post.data.youtubeId} title={post.data.title} />
          <TikTok id={post.data.tiktokId} caption={post.data.title} />
        </div>
      ) : post.data.youtubeId ? (
        <div class="mt-8 min-w-0 mx-auto w-full max-w-3xl">
          <YouTube id={post.data.youtubeId} title={post.data.title} />
        </div>
      ) : (
        <div class="mt-8 min-w-0">
          <TikTok id={post.data.tiktokId ?? ''} caption={post.data.title} />
        </div>
      )
    )}

    <AdSlot unit={adSlots.postTop} label={t.adLabel} />

    <div class="mt-8 grid min-w-0 md:grid-cols-[minmax(0,1fr)_56px] gap-8">
      <div class="prose-stamp min-w-0 overflow-hidden bg-white/60 dark:bg-white/5 rounded p-4 sm:p-6 md:p-8 border border-black/10 dark:border-white/10">
        <Content />
      </div>
      <aside class="hidden md:block">
        <div class="tate font-bold text-sm opacity-70 h-64 border-l-2 border-dotted border-current/30 pl-2">
          {date} - {post.data.title}
        </div>
        <div class="hanko w-10 h-10 mt-4 rounded-[3px] text-xs">DEV</div>
      </aside>
    </div>

    <AdSlot unit={adSlots.postBottom} label={t.adLabel} />

    <div class="mt-8 flex flex-wrap gap-3 justify-between text-sm font-bold">
      <a href="/id/blog/" class="underline underline-offset-4 hover:opacity-70">{t.backToPosts}</a>
      <a href="/id/" class="underline underline-offset-4 hover:opacity-70">{t.home}</a>
    </div>
  </article>
</BaseLayout>
